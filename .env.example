# ==============================================================================
# Confluence + Jira RAG Assistant - Environment Configuration Template
# Copy this file to `.env` and fill in your confidential credentials and keys.
# NEVER commit your `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Atlassian Confluence Configuration
# ------------------------------------------------------------------------------
# Base URL for your Confluence Cloud instance (e.g., https://your-domain.atlassian.net)
CONFLUENCE_BASE_URL=https://your-domain.atlassian.net

# Atlassian account email address used for Basic Authentication
CONFLUENCE_EMAIL=your-email@example.com

# Atlassian API Token generated from https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=your-confluence-api-token

# Default Confluence Space Key to ingest (e.g., ENG, DOCS, KB)
CONFLUENCE_SPACE_KEY=ENG

# ------------------------------------------------------------------------------
# 2. Atlassian Jira Configuration
# ------------------------------------------------------------------------------
# Base URL for your Jira Cloud instance (usually matches CONFLUENCE_BASE_URL)
JIRA_BASE_URL=https://your-domain.atlassian.net

# Jira user email address
JIRA_EMAIL=your-email@example.com

# Jira API token (can be the same Atlassian token as Confluence)
JIRA_API_TOKEN=your-jira-api-token

# Default Jira Project Key to query (e.g., PAY, PROJ, SRE)
JIRA_PROJECT_KEY=PAY

# ------------------------------------------------------------------------------
# 3. Qdrant Vector Database Configuration
# ------------------------------------------------------------------------------
# Local embedded database directory path (used by default when QDRANT_URL is empty)
QDRANT_PATH=data/qdrant_db

# Qdrant collection name
QDRANT_COLLECTION_NAME=knowledge_base

# (Optional) Remote Qdrant Cloud or Server URL (e.g., https://xyz-example.qdrant.io:6333)
QDRANT_URL=

# (Optional) Remote Qdrant API Key
QDRANT_API_KEY=

# ------------------------------------------------------------------------------
# 4. Embeddings & LLM Generation Configuration
# ------------------------------------------------------------------------------
# Embedding model name (FastEmbed / HuggingFace)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# (Optional) LLM API Keys for RAG Answer Synthesis (Milestones 8, 9, 10)
DEFAULT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=stealth/ox-alpha
OPENROUTER_REASONING=true

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

